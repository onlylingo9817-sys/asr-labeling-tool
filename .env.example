# Copy to .env. All integrations are disabled by default.
ENABLE_SYNC=0
ENABLE_VOICEPRINT=0
# Label Studio local binary (used only for API token refresh)
LS_BIN=label-studio
LABEL_STUDIO_URL=http://localhost:8080
# Comma-separated task IDs whose existing Annotation is read-only
LS_READ_ONLY_TASKS=5
# Optional explicit task -> LS audio mapping; defaults to app/editor/data.json lsAudio
TASKS_JSON={}


# Preprocess / ASR
# Pulling tasks with no annotation automatically runs ASR when 1.
AUTO_ASR=1
# Python environment that has funasr installed. Use a venv path; defaults to
# .venv/bin/python or work/asr-venv/bin/python if present.
ASR_PYTHON=
# Optional explicit path to interjection_nested.py
ASR_SCRIPT=
ASR_TIMEOUT=3600
